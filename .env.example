# Copy to .env (git-ignored) and adjust. Never put real secrets in this file.

# Where ALL private data lives (database, notes, documents, indexes, backups).
# Must be OUTSIDE this repository; the app refuses to start otherwise.
PPOS_LOCAL_DATA_DIR=~/PersonalProductivityData

PPOS_HOST=127.0.0.1
PPOS_PORT=8765
PPOS_DEFAULT_CAPACITY_MINUTES=360
PPOS_NOTE_SNAPSHOT_INTERVAL_SECONDS=120

# Existing databases are never migrated implicitly. Use `ppos migrate up`.
PPOS_AUTO_MIGRATE=false
PPOS_LOG_LEVEL=INFO

# Local AI (Prompt Book → Improve with AI). Off unless provider and model are set.
# Non-local endpoints are refused unless PPOS_LLM_ALLOW_REMOTE=true. No cloud fallback.
# PPOS_LLM_PROVIDER=ollama            # or openai_compatible (vLLM, LM Studio, llama.cpp)
# PPOS_LLM_MODEL=qwen3:8b
# PPOS_LLM_BASE_URL=http://127.0.0.1:11434
# PPOS_LLM_TIMEOUT_SECONDS=120
