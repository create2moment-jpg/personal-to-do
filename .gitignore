# ---------------------------------------------------------------------------
# PRIVATE DATA BOUNDARY — personal runtime data must never enter Git.
# It lives in PPOS_LOCAL_DATA_DIR (default ~/PersonalProductivityData).
# scripts/check_repo_safety.py enforces this as a pre-commit hook and in CI.
# ---------------------------------------------------------------------------
PersonalProductivityData/
local_data/
/data/
*.sqlite
*.sqlite3
*.sqlite3-*
*.db
*.db-*
*.npy
*.npz
*.faiss
*.index
*.parquet
*.pkl
*.pickle
backups/
exports/
*.tar.gz
*.bak

# Secrets and private configuration
.env
.env.*
!.env.example
*.pem
*.key
config/local*.toml
config/*.local.*

# Documents (originals belong in LOCAL_DATA_DIR/documents); fixtures are allowed
*.pdf
*.docx
*.xlsx
*.pptx
!fixtures/**
!tests/fixtures/**

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/

# Node / web
node_modules/
apps/web/dist/
*.tsbuildinfo
.vite/

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
